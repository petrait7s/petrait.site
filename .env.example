# Copy to .env (development) or set in your hosting provider. Never commit real values.

# Public canonical URL, no trailing slash. REQUIRED in production
# (canonical links, sitemap, robots.txt, Open Graph, structured data).
# Build-time variable: set it where the site is BUILT, not only where it is served.
PUBLIC_SITE_URL=https://www.your-domain.com

# Where the "Request a demo" form posts its JSON (a Formspree form URL like https://formspree.io/f/xxxxxxxx,
# or any endpoint that accepts a JSON POST and emails or stores it). Build-time variable.
# If empty, the form still works: it opens an email to the company with every field filled in.
PUBLIC_INQUIRY_ENDPOINT=
