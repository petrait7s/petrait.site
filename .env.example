# Copy to .env (development) or set in your hosting provider. Never commit real values.

# Public canonical URL without a trailing slash. REQUIRED in production
# (canonical links, sitemap, robots, Open Graph, structured data).
PUBLIC_SITE_URL=https://www.your-domain.com

# Phase 6 (demo form): where demo requests are delivered. REQUIRED in production, https only.
INQUIRY_WEBHOOK_URL=

# Phase 6: optional shared secret for signing webhook requests.
INQUIRY_WEBHOOK_SECRET=
