---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import { site } from "../content/site";

const updated = "6 November 2026";
---

<BaseLayout title="Privacy notice" description="How PETRA Software Solutions handles the details you send through this website.">
  <PageHero eyebrow="Legal" title="Privacy notice" lede={`Last updated ${updated}.`} />
  <section class="px-6 py-20 sm:px-10 sm:py-24">
    <div class="mx-auto max-w-3xl space-y-10 text-[15px] leading-relaxed text-ink-2 [&_h2]:mb-3 [&_h2]:text-[13px] [&_h2]:font-medium [&_h2]:uppercase [&_h2]:tracking-[0.16em] [&_h2]:text-ink [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5">
      <section data-reveal>
        <h2>Who we are</h2>
        <p>
          This website is run by {site.legalName}, {site.country}. Contact: <a class="text-ink underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>, {site.phone}.
        </p>
      </section>
      <section data-reveal>
        <h2>What we collect</h2>
        <p>Only what you type into the demo request form:</p>
        <ul>
          <li>Your name, email address and phone number, and your company name if you add it.</li>
          <li>The type of business, the products you are interested in and a description of your operation.</li>
          <li>A preferred call date, if you add one.</li>
        </ul>
        <p class="mt-3">This website does not use advertising or analytics cookies, does not track you across other sites and does not ask you to create an account.</p>
      </section>
      <section data-reveal>
        <h2>How we use it</h2>
        <p>To reply to your inquiry, arrange a demo and discuss a possible project. We do not sell your details or add you to a mailing list.</p>
      </section>
      <section data-reveal>
        <h2>Where it goes</h2>
        <p>
          When you send the form, your details are passed to an online form service that delivers them to our email inbox. That service handles your details only to deliver them to us. If the form
          is unavailable, the page offers an email with the same details pre-filled, which you send from your own email account.
        </p>
      </section>
      <section data-reveal>
        <h2>How long we keep it</h2>
        <p>For as long as needed to handle your inquiry and any project that follows. Ask us and we will delete it.</p>
      </section>
      <section data-reveal>
        <h2>Your choices</h2>
        <p>You can ask to see, correct or delete the details you sent by writing to <a class="text-ink underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </section>
      <section data-reveal>
        <h2>Links to other sites</h2>
        <p>Our Facebook link opens {`Facebook's`} website in a new tab. Facebook has its own privacy rules, which we do not control.</p>
      </section>
    </div>
  </section>
</BaseLayout>
