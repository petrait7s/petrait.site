---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout title="Something went wrong" noindex>
  <section class="mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center px-6 pb-16 pt-32">
    <p class="mb-3 text-[11.5px] font-medium text-accent-text">Error 500</p>
    <h1 class="mb-3 text-[1.75rem] font-medium leading-[1.15] tracking-tight">Something went wrong on our side.</h1>
    <p class="mb-6 max-w-md text-[13px] text-ink-2">
      Please try again in a moment. If it keeps happening, email <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <a href="/" class="self-start rounded-full border border-accent-text px-5 py-2.5 text-[13px] font-medium text-accent-text transition-colors hover:bg-accent-text hover:text-white">Back to home</a>
  </section>
</BaseLayout>
