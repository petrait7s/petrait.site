---
interface Props {
  status: "available" | "preview" | "planned";
  dark?: boolean;
}
const { status, dark = false } = Astro.props;
const label = { available: "Available", preview: "Preview", planned: "Planned" }[status];
const tone = dark
  ? { available: "bg-glow text-ink", preview: "border border-white/40 text-white", planned: "border border-dashed border-white/40 text-white/80" }
  : { available: "bg-accent-text text-white", preview: "border border-ink-3 text-ink-2", planned: "border border-dashed border-ink-3 text-ink-3" };
---

<span class:list={["inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10.5px] font-medium", tone[status]]}>
  {status === "preview" && <i class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />}
  {label}
</span>
