---
interface Props {
  href: string;
  variant?: "light" | "dark";
  label?: boolean;
  class?: string;
}
const { href, variant = "light", label = true, class: extra = "" } = Astro.props;
const tone =
  variant === "dark"
    ? "border border-white/25 text-white hover:border-[#1877f2] hover:bg-[#1877f2]"
    : "border border-line bg-white text-ink hover:border-[#1877f2] hover:bg-[#1877f2] hover:text-white";
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label ? undefined : "PETRA on Facebook (opens in a new tab)"}
  class:list={["group inline-flex items-center gap-2.5 rounded-full text-[13px] font-medium transition-[transform,box-shadow,border-color,background-color] duration-200", label ? "h-11 pl-1.5 pr-5" : "h-11 w-11 justify-center", tone, extra]}
>
  <span class:list={["grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#1877f2] text-white transition-colors group-hover:bg-white group-hover:text-[#1877f2]", !label && "h-9 w-9"]}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path>
    </svg>
  </span>
  {label && <span>Facebook</span>}
  {label && <span class="sr-only">(opens in a new tab)</span>}
</a>
