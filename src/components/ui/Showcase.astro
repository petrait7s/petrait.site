---
import DeviceFrame from "./DeviceFrame.astro";
import LiveScreen from "./LiveScreen.astro";

interface Props {
  id: string;
  name: string;
  screens: { page: string; view: string; label: string; alt: string }[];
}
const { id, name, screens } = Astro.props;
---

<div class="showcase" data-showcase data-mode="phone">
  <div role="tablist" aria-label={`${name} screens`} class="no-scrollbar -mx-5 mb-4 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:mb-6 sm:flex-wrap sm:overflow-visible sm:px-0">
    {
      screens.map((s, i) => (
        <button
          role="tab"
          type="button"
          id={`${id}-tab-${i}`}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`${id}-panel-${i}`}
          tabindex={i === 0 ? 0 : -1}
          class="press shrink-0 whitespace-nowrap rounded-full border border-white/20 px-4 py-2 text-[12px] font-medium text-white/70 transition-colors hover:text-white aria-selected:border-glow aria-selected:bg-white/10 aria-selected:text-white sm:py-1.5"
        >
          {s.label}
        </button>
      ))
    }
  </div>
  {
    screens.map((s, i) => (
      <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} hidden={i !== 0} class="relative">
        <div class="grid items-end gap-6 sm:grid-cols-[1fr_auto]">
          <div class="dev-desktop">
            <DeviceFrame kind="desktop">
              <LiveScreen page={s.page} view={s.view} kind="desktop" alt={`${s.alt} (desktop)`} title={`${name}: ${s.label}`} eager={i === 0} />
            </DeviceFrame>
          </div>
          <div class="dev-phone">
            <DeviceFrame kind="phone" class="mx-auto w-[210px] sm:w-[170px] lg:w-[200px]">
              <LiveScreen page={s.page} view={s.view} kind="phone" alt={`${s.alt} (mobile)`} title={`${name}: ${s.label}, mobile`} eager={i === 0} />
            </DeviceFrame>
          </div>
        </div>
      </div>
    ))
  }
  <div class="mt-4 flex justify-center sm:hidden">
    <button type="button" data-device-toggle class="press rounded-full border border-white/25 px-4 py-2 text-[12px] font-medium text-white/85">Show desktop view</button>
  </div>
</div>

<style>
  @media (max-width: 639px) {
    .showcase[data-mode="phone"] .dev-desktop { display: none; }
    .showcase[data-mode="desktop"] .dev-phone { display: none; }
  }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = "1";
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const select = (n: number, focus = false) => {
        tabs.forEach((t, i) => {
          t.setAttribute("aria-selected", String(i === n));
          t.tabIndex = i === n ? 0 : -1;
        });
        panels.forEach((p, i) => (p.hidden = i !== n));
        if (focus) tabs[n].focus();
      };
      const toggle = root.querySelector<HTMLButtonElement>("[data-device-toggle]");
      toggle?.addEventListener("click", () => {
        const desktop = root.dataset.mode !== "desktop";
        root.dataset.mode = desktop ? "desktop" : "phone";
        toggle.textContent = desktop ? "Show mobile view" : "Show desktop view";
      });
      tabs.forEach((t, i) => {
        t.addEventListener("click", () => select(i));
        t.addEventListener("keydown", (e) => {
          const k = e.key;
          if (k !== "ArrowRight" && k !== "ArrowLeft" && k !== "Home" && k !== "End") return;
          e.preventDefault();
          const n = k === "Home" ? 0 : k === "End" ? tabs.length - 1 : (i + (k === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
          select(n, true);
        });
      });
    });
  }
  document.addEventListener("astro:page-load", bind);
</script>
