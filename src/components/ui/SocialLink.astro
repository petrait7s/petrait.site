---
interface Props {
  network: "facebook" | "instagram";
  href: string;
  variant?: "light" | "dark" | "mono";
  label?: boolean;
  class?: string;
}
const { network, href, variant = "light", label = true, class: extra = "" } = Astro.props;
const meta = {
  facebook: {
    name: "Facebook",
    badge: "bg-[#1877f2]",
    hover: "hover:border-[#1877f2] hover:bg-[#1877f2]",
    ink: "group-hover:text-[#1877f2]",
    path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
  },
  instagram: {
    name: "Instagram",
    badge: "bg-[linear-gradient(45deg,#f9a03c,#e1306c_55%,#833ab4)]",
    hover: "hover:border-[#e1306c] hover:bg-[#e1306c]",
    ink: "group-hover:text-[#e1306c]",
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z",
  },
}[network];
const mono = variant === "mono";
const tone = mono
  ? "border border-glow/30 bg-glow/10 text-glow hover:bg-glow hover:text-stage"
  : variant === "dark"
    ? `border border-white/25 text-white ${meta.hover}`
    : `border border-line bg-white text-ink ${meta.hover} hover:text-white`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label ? undefined : `PETRA on ${meta.name} (opens in a new tab)`}
  class:list={["press group inline-flex items-center gap-2.5 rounded-full text-[13px] font-medium transition-[transform,box-shadow,border-color,background-color] duration-200", label ? "h-11 pl-2 pr-5" : mono ? "h-10 w-10 justify-center" : "h-11 w-11 justify-center", tone, extra]}
>
  <span class:list={["grid shrink-0 place-items-center rounded-full transition-colors", mono ? (label ? "h-8 w-8" : "h-full w-full") : ["h-8 w-8 text-white group-hover:bg-white", meta.badge, meta.ink, !label && "h-9 w-9"]]}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d={meta.path}></path></svg>
  </span>
  {label && <span>{meta.name}</span>}
  {label && <span class="sr-only">(opens in a new tab)</span>}
</a>
