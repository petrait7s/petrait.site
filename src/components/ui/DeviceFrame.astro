---
interface Props {
  kind: "desktop" | "phone";
  class?: string;
}
const { kind, class: extra = "" } = Astro.props;
---

{
  kind === "desktop" ? (
    <div class:list={["overflow-hidden rounded-xl border border-white/15 bg-stage shadow-[0_30px_80px_-20px_rgba(0,0,0,0.55)]", extra]}>
      <div class="flex h-6 items-center gap-1.5 border-b border-white/10 px-3" aria-hidden="true">
        <i class="h-1.5 w-1.5 rounded-full bg-glow" /><i class="h-1.5 w-1.5 rounded-full bg-white/25" /><i class="h-1.5 w-1.5 rounded-full bg-white/25" />
      </div>
      <slot />
    </div>
  ) : (
    <div class:list={["relative drop-shadow-[0_26px_36px_rgba(0,0,0,0.55)]", extra]}>
      <!-- keys, all on the right edge -->
      <i class="absolute -right-[2.5px] top-[20%] h-[9%] w-[3px] rounded-r bg-[#8791a6]" aria-hidden="true"></i>
      <i class="absolute -right-[2.5px] top-[32%] h-[5%] w-[3px] rounded-r bg-[#8791a6]" aria-hidden="true"></i>
      <!-- flat satin frame, thin even bezel, glass -->
      <div class="rounded-[1.9rem] bg-[linear-gradient(160deg,#d4dae6,#8a93a6_30%,#4b5368_55%,#8a93a6_80%,#cfd6e2)] p-[2.5px] shadow-[0_0_0_1px_rgba(255,255,255,0.1),0_0_36px_-10px_rgba(20,184,166,0.45)]">
        <div class="rounded-[1.75rem] bg-black p-[4px]">
          <div class="relative overflow-hidden rounded-[1.5rem] bg-stage">
            <slot />
            <i class="pointer-events-none absolute inset-0 bg-[linear-gradient(125deg,rgba(255,255,255,0.12),rgba(255,255,255,0)_30%,rgba(255,255,255,0)_72%,rgba(255,255,255,0.05))]" aria-hidden="true"></i>
          </div>
        </div>
      </div>
    </div>
  )
}
