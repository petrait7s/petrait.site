---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  kind: "desktop" | "phone";
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { kind, src, alt, eager = false, sizes, class: extra = "" } = Astro.props;
const widths = kind === "desktop" ? [480, 800, 1200, 1600] : [200, 320, 480];
---

{
  kind === "desktop" ? (
    <div class:list={["overflow-hidden rounded-xl border border-white/15 bg-stage shadow-[0_30px_80px_-20px_rgba(0,0,0,0.55)]", extra]}>
      <div class="flex h-6 items-center gap-1.5 border-b border-white/10 px-3" aria-hidden="true">
        <i class="h-1.5 w-1.5 rounded-full bg-glow" /><i class="h-1.5 w-1.5 rounded-full bg-white/25" /><i class="h-1.5 w-1.5 rounded-full bg-white/25" />
      </div>
      <Image src={src} alt={alt} widths={widths} sizes={sizes ?? "(min-width: 1024px) 720px, 92vw"} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" class="block h-auto w-full" />
    </div>
  ) : (
    <div class:list={["overflow-hidden rounded-[2rem] border-[6px] border-[#050b16] bg-stage shadow-[0_30px_70px_-20px_rgba(0,0,0,0.6)] ring-1 ring-white/15", extra]}>
      <Image src={src} alt={alt} widths={widths} sizes={sizes ?? "(min-width: 1024px) 220px, 40vw"} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" class="block h-auto w-full" />
    </div>
  )
}
