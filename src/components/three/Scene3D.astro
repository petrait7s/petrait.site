---
import { getImage } from "astro:assets";
import Canvas3D, { type SceneId } from "../../three/Canvas3D";
import { posterFor } from "../../lib/posters";

interface Props {
  scene: SceneId;
  description: string;
  aspect?: string;
  class?: string;
}
const { scene, description, aspect, class: extra = "" } = Astro.props;
const meta = posterFor(scene);
const poster = meta ? (await getImage({ src: meta, width: 1600, format: "webp" })).src : undefined;
---

<Canvas3D client:visible scene={scene} description={description} poster={poster} aspect={aspect} className={extra} />
