---
import Aurora from "../ui/Aurora.astro";
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="stage px-6 pb-20 pt-36 sm:px-10 sm:pb-24 sm:pt-44">
  <Aurora calm />
  <div class="mx-auto max-w-6xl">
    <p class="mb-4 text-[11.5px] font-medium uppercase tracking-[0.2em] text-glow" data-reveal>{eyebrow}</p>
    <h1 class="max-w-3xl text-[2.2rem] font-medium leading-[1.05] tracking-tight sm:text-[3.4rem]" data-reveal style="--d:1"><span class="gradient-text">{title}</span></h1>
    {lede && <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-white/70" data-reveal style="--d:2">{lede}</p>}
    <slot />
  </div>
</section>
