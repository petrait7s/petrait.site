---
import Aurora from "../ui/Aurora.astro";
import Wave from "../ui/Wave.astro";
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="stage px-5 pb-12 pt-[4.5rem] sm:px-10 sm:pb-28 sm:pt-44">
  <Aurora calm />
  <div class="mx-auto max-w-6xl">
    <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-glow sm:mb-4 sm:text-[11.5px]" data-reveal>{eyebrow}</p>
    <h1 class="max-w-3xl text-[1.85rem] font-medium leading-[1.06] tracking-tight sm:text-[3.4rem]" data-reveal style="--d:1"><span class="gradient-text">{title}</span></h1>
    {lede && <p class="mt-3 max-w-xl text-[13.5px] leading-relaxed text-white/70 sm:mt-5 sm:text-[15px]" data-reveal style="--d:2">{lede}</p>}
    <slot />
  </div>
  <Wave />
</section>
