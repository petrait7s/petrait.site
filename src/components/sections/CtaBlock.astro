---
import Button from "../ui/Button.astro";
import FacebookLink from "../ui/FacebookLink.astro";
import { site } from "../../content/site";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "See Petra running on your property.",
  text = "Tell us about your operation, the products you are considering, or the software you need built. We will walk you through our products live, on sample data. We reply within one working day. No commitment.",
} = Astro.props;
---

<section class="px-4 py-8 sm:px-10 sm:py-28">
  <div class="stage mx-auto max-w-6xl rounded-3xl px-5 py-8 sm:px-14 sm:py-20" data-reveal>
    <div class="grid gap-6 md:grid-cols-[1.3fr_1fr] md:items-end md:gap-10">
      <div>
        <h2 class="text-[1.35rem] font-medium leading-[1.12] tracking-tight sm:text-[2.4rem]"><span class="gradient-text">{title}</span></h2>
        <p class="mt-2 max-w-md text-[13px] leading-relaxed text-white/70 sm:mt-4 sm:text-[14px]">{text}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:flex md:flex-col">
        <Button href="/contact" variant="teal" class="col-span-2">Book a demo</Button>
        <a href={`mailto:${site.email}`} class="press inline-flex h-11 items-center justify-center rounded-xl border border-white/25 px-3 text-[12.5px] font-medium text-white transition-colors hover:bg-white hover:text-ink sm:px-5 sm:text-[13px]">Email us</a>
        <a href={`tel:${site.phoneHref}`} class="press inline-flex h-11 items-center justify-center rounded-xl border border-white/25 px-3 text-[12.5px] font-medium text-white transition-colors hover:bg-white hover:text-ink sm:px-5 sm:text-[13px]">{site.phone}</a>
        <FacebookLink href={site.facebook} variant="dark" class="col-span-2 justify-center" />
      </div>
    </div>
  </div>
</section>
