---
import Button from "../ui/Button.astro";
import SocialLink from "../ui/SocialLink.astro";
import { site } from "../../content/site";

interface Props {
  title?: string;
  text?: string;
}
const ic = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
};
const {
  title = "See Petra running on your property.",
  text = "Tell us about your operation, the products you are considering, or the software you need built. We will walk you through our products live, on sample data. We reply within one working day. No commitment.",
} = Astro.props;
---

<section class="px-4 pb-4 pt-8 sm:px-10 sm:py-28">
  <div class="stage mx-auto max-w-6xl rounded-3xl px-5 py-8 sm:px-14 sm:py-20" data-reveal>
    <div class="grid gap-6 md:grid-cols-[1.3fr_1fr] md:items-end md:gap-10">
      <div>
        <h2 class="text-[1.35rem] font-medium leading-[1.12] tracking-tight sm:text-[2.4rem]"><span class="gradient-text">{title}</span></h2>
        <p class="mt-2 max-w-md text-[13px] leading-relaxed text-white/70 sm:mt-4 sm:text-[14px]">{text}</p>
      </div>
      <!-- phone: compact grid -->
      <div class="grid grid-cols-2 gap-2.5 sm:hidden">
        <Button href="/contact" variant="teal" class="col-span-2">Book a demo</Button>
        <a href={`mailto:${site.email}`} class="press flex h-11 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 text-[12.5px] font-medium text-white/90">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-glow" aria-hidden="true" set:html={ic.mail} />Email us
        </a>
        <a href={`tel:${site.phoneHref}`} class="press flex h-11 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 text-[12.5px] font-medium text-white/90">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-glow" aria-hidden="true" set:html={ic.phone} />Call
        </a>
        <div class="col-span-2 flex justify-center gap-2">
          <SocialLink network="facebook" href={site.facebook} variant="mono" />
          <SocialLink network="instagram" href={site.instagram} variant="mono" />
        </div>
      </div>
      <!-- tablet and desktop: one primary action, two quiet contact tiles, two small social icons -->
      <div class="flex flex-col gap-2.5 max-sm:hidden">
        <Button href="/contact" variant="teal">Book a demo</Button>
        <div class="grid grid-cols-2 gap-2.5">
          <a href={`mailto:${site.email}`} class="liquid press flex h-11 items-center gap-2.5 rounded-xl border border-white/15 bg-white/5 px-3.5 text-[12.5px] font-medium text-white/90 transition-colors hover:text-ink [--fill:#5eead4]">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-glow" aria-hidden="true" set:html={ic.mail} />Email us
          </a>
          <a href={`tel:${site.phoneHref}`} class="liquid press flex h-11 items-center gap-2.5 rounded-xl border border-white/15 bg-white/5 px-3.5 text-[12.5px] font-medium text-white/90 transition-colors hover:text-ink [--fill:#5eead4]">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-glow" aria-hidden="true" set:html={ic.phone} />{site.phone}
          </a>
        </div>
        <div class="flex items-center gap-2 pt-1">
          <span class="mr-1 text-[11px] uppercase tracking-[0.2em] text-white/45">Follow</span>
          <SocialLink network="facebook" href={site.facebook} variant="mono" label={false} />
          <SocialLink network="instagram" href={site.instagram} variant="mono" label={false} />
        </div>
      </div>
    </div>
  </div>
</section>
