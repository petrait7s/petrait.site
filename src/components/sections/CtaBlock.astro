---
import Button from "../ui/Button.astro";
import { site } from "../../content/site";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "See Petra running on your property.",
  text = "Tell us about your operation and the products you are considering. We will walk you through them live, on sample data. We reply within one working day. No commitment.",
} = Astro.props;
---

<section class="px-6 py-20 sm:px-10 sm:py-28">
  <div class="stage mx-auto max-w-6xl rounded-3xl px-7 py-14 sm:px-14 sm:py-20" data-reveal>
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-end">
      <div>
        <h2 class="text-[1.75rem] font-medium leading-[1.1] tracking-tight sm:text-[2.4rem]"><span class="gradient-text">{title}</span></h2>
        <p class="mt-4 max-w-md text-[14px] leading-relaxed text-white/70">{text}</p>
      </div>
      <div class="flex flex-col gap-3">
        <Button href="/contact" variant="teal">Book a demo</Button>
        <a href={`mailto:${site.email}`} class="inline-flex h-11 items-center justify-center rounded-xl border border-white/25 px-5 text-[13px] font-medium text-white transition-colors hover:bg-white hover:text-ink">{site.email}</a>
        <a href={`tel:${site.phoneHref}`} class="inline-flex h-11 items-center justify-center rounded-xl border border-white/25 px-5 text-[13px] font-medium text-white transition-colors hover:bg-white hover:text-ink">{site.phone}</a>
      </div>
    </div>
  </div>
</section>
