---
import { glance } from "../../content/company";
---

<section class="bg-surface px-5 py-6 sm:px-10 sm:py-12" aria-label="PETRA at a glance">
  <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-x-5 gap-y-4 sm:gap-8 lg:grid-cols-4">
    {
      glance.map((g, i) => (
        <li data-reveal style={`--d:${i}`}>
          <p class="text-[12.5px] font-medium sm:text-[13px]">{g.title}</p>
          <p class="mt-1 text-[11.5px] leading-snug text-ink-2 sm:mt-1.5 sm:text-[12.5px] sm:leading-relaxed">{g.text}</p>
        </li>
      ))
    }
  </ul>
</section>
