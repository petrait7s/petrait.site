---
import { getCollection } from "astro:content";
import Chip from "../ui/Chip.astro";
import SectionHead from "../ui/SectionHead.astro";
import { tints } from "../../lib/tints";

const industries = await getCollection("industries");
const products = await getCollection("products");
const byCode = Object.fromEntries(products.map((p) => [p.data.code, p]));
const span = ["lg:col-span-2", "lg:col-span-2", "lg:col-span-2", "lg:col-span-3", "sm:col-span-2 lg:col-span-3"];
---

<section id="industries" class="px-5 py-9 sm:px-10 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHead eyebrow="Industries" title="Built for the people who host, serve and move guests." />
    <ul class="hs grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        industries.map((ind, i) => (
          <li class:list={["spot flex flex-col rounded-2xl border p-5 transition-[transform,box-shadow,border-color,background-color] duration-300 hover:-translate-y-1 sm:p-7", tints[i % tints.length].card, span[i]]} data-reveal style={`--d:${i % 3}`}>
            <span aria-hidden="true" data-n={`0${i + 1}`} class:list={["text-[30px] font-semibold leading-none tracking-tight before:content-[attr(data-n)] sm:text-[34px]", tints[i % tints.length].num]}></span>
            <h3 class="mt-3 text-[18px] font-medium tracking-tight sm:mt-6 sm:text-[19px]">{ind.data.name}</h3>
            <p class="mt-2 flex-1 text-[13px] leading-relaxed text-ink-2">{ind.data.line}</p>
            <ul class="mt-4 flex flex-wrap gap-2 border-t border-ink/10 pt-3 sm:mt-5 sm:pt-4" aria-label={`Petra products for ${ind.data.name}`}>
              {ind.data.products.map((code) => (
                <li>
                  <a href={`/products/${byCode[code].id}`} class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-[11.5px] font-medium text-ink hover:bg-accent-text hover:text-white">
                    {byCode[code].data.name}
                    <Chip status={byCode[code].data.status} />
                  </a>
                </li>
              ))}
              {ind.data.module && (
                <li class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11.5px] text-ink-2">
                  {ind.data.module}
                  <Chip status="onrequest" />
                </li>
              )}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
