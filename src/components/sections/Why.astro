---
import { getCollection } from "astro:content";
import SectionHead from "../ui/SectionHead.astro";

const reasons = await getCollection("reasons");
---

<section id="why" class="bg-surface px-5 py-9 sm:px-10 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHead eyebrow="Why Petra" title="Specific advantages, not slogans." />
    <div class="hs grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        reasons.map((r, i) => (
          <article class="spot relative overflow-hidden rounded-2xl border border-line bg-white p-5 sm:p-7" data-reveal style={`--d:${i % 3}`}>
            <span aria-hidden="true" data-n={String(i + 1).padStart(2, "0")} class="absolute -bottom-5 -right-1 text-[84px] font-semibold leading-none tracking-tight text-accent/[0.07] before:content-[attr(data-n)]"></span>
            <h3 class="relative text-[15.5px] font-medium tracking-tight">{r.data.title}</h3>
            <p class="relative mt-3 max-w-[34ch] text-[13px] leading-relaxed text-ink-2">{r.data.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
