---
import SectionHead from "../ui/SectionHead.astro";
import { trustPrinciples } from "../../content/company";
---

<section id="trust" class="px-5 py-9 sm:px-10 sm:py-32" aria-labelledby="trust-title">
  <div class="mx-auto max-w-6xl">
    <SectionHead id="trust-title" eyebrow="Trust" title="What “built on trust” means here." lede="Four commitments we can stand behind, and that you can check." />
    <div class="hs grid gap-5 sm:grid-cols-2">
      {
        trustPrinciples.map((t, i) => (
          <article class="spot relative overflow-hidden rounded-2xl border border-line bg-white p-5 sm:p-8" data-reveal style={`--d:${i % 2}`}>
            <span class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-accent to-transparent opacity-60" aria-hidden="true"></span>
            <p class="text-[11px] font-medium tracking-[0.22em] text-accent-text">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 text-[19px] font-medium tracking-tight">{t.title}</h3>
            <p class="mt-3 max-w-[44ch] text-[13.5px] leading-relaxed text-ink-2">{t.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
