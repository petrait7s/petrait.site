---
import { Image } from "astro:assets";
import Aurora from "../ui/Aurora.astro";
import Button from "../ui/Button.astro";
import DeviceFrame from "../ui/DeviceFrame.astro";
import Wave from "../ui/Wave.astro";
import { screenImage } from "../../lib/screens";

/** One slide per product: the sample screen that best shows what it does. Text is sample data, labelled as such. */
const slides = [
  { key: "PMS", name: "PetraPMS · Hotel management", page: "petrapms", view: "dashboard", alt: "PetraPMS front-desk overview (sample data)", f: [["78%", "occupied today"], ["14", "arrivals this shift"], "Hotel sample data"] },
  { key: "POS", name: "PetraPOS · Restaurant POS", page: "petrapos", view: "order", alt: "PetraPOS order screen (sample data)", f: [["Table 7", "new order · 3 items"], ["৳ 58,640", "today's sales"], "Restaurant sample data"] },
  { key: "DMS", name: "PetraDMS · Distribution", page: "petradms", view: "dashboard", alt: "PetraDMS sales overview (sample data)", f: [["৳ 4.2L", "dues this week"], ["142", "invoices today"], "Distribution sample data"] },
  { key: "WEB", name: "Website Build · sites that work for you", page: "website", view: "restaurant", alt: "A restaurant website built with Website Build (sample site)", f: [["Menu", "online in one day"], ["1.2s", "page load"], "Sample website"] },
  { key: "SHOP", name: "E-commerce Build · online store", page: "stores", view: "gadgets", alt: "A gadget store built with E-commerce Build (sample store)", f: [["Order #4021", "paid with bKash"], ["৳ 6,800", "cart total"], "Sample store"] },
];
const sectors = ["Hospitality software", "Business software", "Marketing software", "Enterprise software", "Custom software, any type"];
---

<section class="stage hx" data-hero data-p="0" aria-labelledby="hero-title">
  <Aurora />
  <div class="mx-auto grid max-w-6xl items-center gap-7 px-5 pb-16 pt-[4.5rem] sm:min-h-[100svh] sm:gap-12 sm:px-10 sm:pb-28 sm:pt-32 lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
    <div>
      <p class="mb-3 inline-flex items-center gap-2 rounded-full glass px-3 py-1 text-[11px] font-medium text-white/80 sm:mb-5 sm:px-3.5 sm:py-1.5 sm:text-[11.5px]" data-reveal>
        <i class="h-1.5 w-1.5 rounded-full bg-glow" aria-hidden="true"></i>
        PETRA Software Solutions · Bangladesh
      </p>
      <h1 id="hero-title" class="text-[2.4rem] font-medium leading-[1.02] tracking-tight sm:text-[4.4rem]" data-reveal style="--d:1">
        Built on <span class="gradient-text">trust.</span>
      </h1>
      <div class="hx-sector" aria-hidden="true" data-reveal style="--d:2">
        {sectors.map((s, i) => <span class:list={[i === 0 && "on"]}>{s}</span>)}
      </div>
      <p class="mt-3 max-w-md text-[14px] leading-relaxed text-white/75 sm:mt-5 sm:text-[16px]" data-reveal style="--d:2">
        Five products in preview, and custom software of any type, built to your demand. Layer by layer, on a foundation that holds.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:mt-8 sm:flex sm:flex-wrap" data-reveal style="--d:3">
        <Button href="/contact" variant="teal">Book a demo</Button>
        <Button href="/contact" variant="ghost-dark">Custom build</Button>
      </div>
      <ul class="mt-6 hidden flex-wrap gap-2 text-[12px] text-white/70 sm:flex" data-reveal style="--d:4">
        <li class="rounded-lg border border-white/12 bg-white/5 px-3 py-1.5">Local-first deployment</li>
        <li class="rounded-lg border border-white/12 bg-white/5 px-3 py-1.5">Support after go-live</li>
        <li class="rounded-lg border border-white/12 bg-white/5 px-3 py-1.5">Built to order</li>
      </ul>
    </div>

    <div class="hx-stage relative pb-[4.2rem]" data-reveal style="--d:2">
      <div class="hx-fc hx-fc1" aria-hidden="true"><b data-f="f1b">{slides[0].f[0][0]}</b><small data-f="f1s">{slides[0].f[0][1]}</small></div>
      <div class="hx-fc hx-fc2" aria-hidden="true"><b data-f="f2b">{slides[0].f[1][0]}</b><small data-f="f2s">{slides[0].f[1][1]}</small></div>
      <div class="hx-fc hx-fc3 hidden sm:block" aria-hidden="true"><small data-f="f3s">{slides[0].f[2]}</small></div>

      <div class="hx-desk mx-auto max-w-[640px] lg:max-w-none">
        <DeviceFrame kind="desktop">
          <div class="hx-stack hx-d">
            {
              slides.map((s, i) => (
                <Image src={screenImage(s.page, s.view, "desktop")} alt={i === 0 ? s.alt : ""} widths={[560, 860, 1100]} sizes="(min-width: 1024px) 620px, 92vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
              ))
            }
          </div>
        </DeviceFrame>
        <div class="hx-phone">
          <DeviceFrame kind="phone">
            <div class="hx-stack hx-p">
              {slides.map((s, i) => <Image src={screenImage(s.page, s.view, "mobile")} alt="" widths={[200, 300, 400]} sizes="150px" loading={i === 0 ? "eager" : "lazy"} decoding="async" />)}
            </div>
          </DeviceFrame>
        </div>
      </div>

      <div class="hx-sw" role="group" aria-label="Choose a product to preview">
        {slides.map((s, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? "true" : "false"} aria-label={`${s.key}: show ${s.name}`} class="press">{s.key}<i class="pg"></i></button>)}
      </div>
      <p class="hx-cap" data-cap>{slides[0].name}</p>
    </div>
  </div>
  <Wave />
  <div class="absolute inset-x-0 bottom-10 hidden border-t border-white/10 sm:bottom-16 sm:block">
    <p class="mx-auto max-w-6xl px-6 py-4 text-[11px] uppercase tracking-[0.2em] text-white/60 sm:px-10">Hospitality · Business · Marketing · Enterprise</p>
  </div>
  <script type="application/json" id="hero-slides" set:html={JSON.stringify(slides.map((s) => ({ name: s.name, f: s.f })))} />
</section>

<script>
  import "../../scripts/hero";
</script>
