---
import Aurora from "../ui/Aurora.astro";
import Button from "../ui/Button.astro";
import DeviceFrame from "../ui/DeviceFrame.astro";
import LiveScreen from "../ui/LiveScreen.astro";
---

<section class="stage" aria-labelledby="hero-title">
  <Aurora />
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 pb-12 pt-[4.5rem] sm:min-h-[100svh] sm:gap-12 sm:px-10 sm:pb-24 sm:pt-32 lg:grid-cols-[0.95fr_1.05fr] lg:gap-8">
    <div>
      <p class="mb-3 inline-flex items-center gap-2 rounded-full glass px-3 py-1 text-[11px] sm:mb-5 sm:px-3.5 sm:py-1.5 sm:text-[11.5px] font-medium text-white/80" data-reveal>
        <i class="h-1.5 w-1.5 rounded-full bg-glow" aria-hidden="true"></i>
        PETRA Software Solutions · Bangladesh
      </p>
      <h1 id="hero-title" class="text-[2.4rem] font-medium leading-[1.02] tracking-tight sm:text-[4.4rem]" data-reveal style="--d:1">
        Built on <span class="gradient-text">trust.</span>
      </h1>
      <p class="mt-3 max-w-md text-[14px] leading-relaxed text-white/75 sm:mt-6 sm:text-[16px]" data-reveal style="--d:2">
        Products for hospitality and business, and custom software of any type, built to your demand. Made the way solid things are made: layer by layer, on a foundation that holds.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:mt-9 sm:flex sm:flex-wrap" data-reveal style="--d:3">
        <Button href="/contact" variant="teal">Book a demo</Button>
        <Button href="/products" variant="ghost-dark">Explore products</Button>
      </div>
      <p class="mt-4 text-[11.5px] text-white/60 sm:mt-8 sm:text-[12px]" data-reveal style="--d:4">All products are in preview. Demos on request.</p>
    </div>

    <div class="relative" data-reveal style="--d:2">
      <div class="relative mx-auto max-w-[640px] pb-8 sm:pb-10 lg:max-w-none">
        <DeviceFrame kind="desktop">
          <LiveScreen page="petrapms" view="dashboard" kind="desktop" eager sizes="(min-width: 1024px) 640px, 92vw" title="PetraPMS front-desk overview" alt="PetraPMS front-desk overview with occupancy, arrivals and room status (sample data)" />
        </DeviceFrame>
        <div class="float absolute -bottom-2 -left-2 w-[26%] min-w-[96px] sm:-left-8">
          <DeviceFrame kind="phone">
            <LiveScreen page="petrapos" view="order" kind="phone" eager sizes="180px" title="PetraPOS order screen" alt="PetraPOS order screen on a smartphone (sample data)" />
          </DeviceFrame>
        </div>
      </div>
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-0 border-t border-white/10">
    <p class="mx-auto hidden max-w-6xl px-6 py-4 text-[11px] uppercase tracking-[0.2em] text-white/60 sm:block sm:px-10">Hospitality · Business · Marketing · Enterprise</p>
  </div>
</section>
