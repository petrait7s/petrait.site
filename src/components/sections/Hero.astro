---
import { Image } from "astro:assets";
import Aurora from "../ui/Aurora.astro";
import Button from "../ui/Button.astro";
import DeviceFrame from "../ui/DeviceFrame.astro";
import Wave from "../ui/Wave.astro";
import { screenImage } from "../../lib/screens";

/** The five products, in switcher order. Each is shown on the laptop with a different product on the phone beside it. */
const shots = [
  { key: "PMS", page: "petrapms", view: "dashboard", alt: "PetraPMS front-desk overview (sample data)" },
  { key: "POS", page: "petrapos", view: "order", alt: "PetraPOS order screen (sample data)" },
  { key: "DMS", page: "petradms", view: "dashboard", alt: "PetraDMS sales overview (sample data)" },
  { key: "WEB", page: "website", view: "restaurant", alt: "A restaurant website built with Website Build (sample site)" },
  { key: "SHOP", page: "stores", view: "gadgets", alt: "A gadget store built with E-commerce Build (sample store)" },
];
// laptop product (l), phone product (p) and the caption for each step
const steps = [
  { l: 0, p: 1, cap: "<b>PetraPMS</b> on the front desk · <b>PetraPOS</b> in the restaurant" },
  { l: 1, p: 0, cap: "<b>PetraPOS</b> at the counter · <b>PetraPMS</b> on the front desk" },
  { l: 2, p: 4, cap: "<b>PetraDMS</b> for the back office · <b>E-commerce Build</b> for the shop" },
  { l: 3, p: 4, cap: "<b>Website Build</b> sites · <b>E-commerce Build</b> stores" },
  { l: 4, p: 3, cap: "<b>E-commerce Build</b> stores · <b>Website Build</b> sites" },
];
---

<section class="stage hx" data-hero data-p="0" aria-labelledby="hero-title">
  <Aurora />
  <div class="mx-auto grid max-w-[1480px] items-center gap-8 px-5 pb-16 pt-[4.5rem] sm:min-h-[100svh] sm:gap-7 sm:px-8 sm:pb-28 sm:pt-32 lg:grid-cols-[minmax(0,0.66fr)_minmax(0,1.34fr)]">
    <div>
      <h1 id="hero-title" class="text-[2.6rem] font-medium leading-[1.02] tracking-tight sm:text-[clamp(2.4rem,4.4vw,4.2rem)]" data-reveal>
        Built on <span class="gradient-text">trust.</span>
      </h1>
      <p class="mt-3 max-w-md text-[14.5px] leading-relaxed text-white/75 sm:mt-5 sm:text-[16px]" data-reveal style="--d:1">
        Software for hotels, restaurants, distribution and online business, and custom software of any type.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:mt-8 sm:flex sm:flex-wrap" data-reveal style="--d:2">
        <Button href="/contact" variant="teal">Book a demo</Button>
        <Button href="/contact" variant="ghost-dark">Custom build</Button>
      </div>
      <p class="mt-6 hidden text-[11.5px] uppercase tracking-[0.2em] text-white/50 sm:mt-9 sm:block" data-reveal style="--d:3">Hospitality · Business · Marketing · Enterprise</p>
    </div>

    <div class="hx-stage relative" data-reveal style="--d:1">
      <div class="hx-lap">
        <DeviceFrame kind="desktop">
          <div class="hx-stack hx-d">
            {
              shots.map((s, i) => (
                <Image src={screenImage(s.page, s.view, "desktop")} alt={i === 0 ? s.alt : ""} widths={[700, 1100, 1500]} sizes="(min-width: 1024px) 800px, 92vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
              ))
            }
          </div>
        </DeviceFrame>
      </div>
      <div class="hx-phone">
        <DeviceFrame kind="phone">
          <div class="hx-stack hx-p">
            {shots.map((s, i) => <Image src={screenImage(s.page, s.view, "mobile")} alt="" widths={[200, 300, 400]} sizes="170px" loading={i === 1 ? "eager" : "lazy"} decoding="async" />)}
          </div>
        </DeviceFrame>
      </div>

      <div class="hx-seg" role="group" aria-label="Choose a product to preview">
        <i class="hx-ind" aria-hidden="true"></i>
        {shots.map((s, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? "true" : "false"} class="press">{s.key}</button>)}
      </div>
      <p class="hx-cap" data-cap set:html={steps[0].cap} />
    </div>
  </div>
  <Wave />
  <script type="application/json" id="hero-steps" set:html={JSON.stringify(steps)} />
</section>

<script>
  import "../../scripts/hero";
</script>
