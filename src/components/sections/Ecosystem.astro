---
import Aurora from "../ui/Aurora.astro";
import { getCollection } from "astro:content";
import Chip from "../ui/Chip.astro";
import SectionHead from "../ui/SectionHead.astro";
import Button from "../ui/Button.astro";
import { core, requestModules } from "../../content/company";

interface Props {
  detail?: boolean;
}
const { detail = false } = Astro.props;
const links = await getCollection("links");
const products = await getCollection("products");

/*
 * Diagram geometry (viewBox 1200 x 720). Top row: modules built on request. Middle: Petra Core (built on request).
 * Bottom row: the five products (preview). Every wire is a connection built on request.
 */
const W = 1200;
const nodeW = 200;
const nodeGap = 32;
const nodeStart = (W - (products.length * nodeW + (products.length - 1) * nodeGap)) / 2;
const nodes = products.map((p, i) => ({
  key: p.data.code.toLowerCase(),
  name: p.data.name,
  code: p.data.code,
  full: p.data.full,
  short: p.data.short,
  x: nodeStart + nodeW / 2 + i * (nodeW + nodeGap),
}));
const nodeByKey = Object.fromEntries(nodes.map((n) => [n.key, n]));
const NODE_Y = 500;
const NODE_H = 96;
const BUS_DOWN = 410;
const CORE = { x: 420, y: 222, w: 360, h: 96 };

const modW = 132;
const modGap = 12;
const modStart = (W - (requestModules.length * modW + (requestModules.length - 1) * modGap)) / 2;
const mods = requestModules.map((m, i) => ({ ...m, cx: modStart + modW / 2 + i * (modW + modGap), x: modStart + i * (modW + modGap) }));
const MOD_Y = 28;
const MOD_H = 60;
const BUS_UP = 150;

const labelW = (s: string) => s.length * 7.8 + 30;
const coreLinks = links.filter((l) => l.data.to === "core" && nodeByKey[l.data.from]);
const sideLinks = links.filter((l) => l.data.to !== "core" && l.data.to !== "all" && nodeByKey[l.data.from] && nodeByKey[l.data.to]);
---

<section id="ecosystem" class="stage px-5 py-9 sm:px-10 sm:py-32">
  <Aurora calm />
  <div class="mx-auto max-w-6xl">
    {!detail && (
    <SectionHead
      dark
      eyebrow="Ecosystem"
      title="Five products today. One shared core next."
      lede="PetraPMS, PetraPOS, PetraDMS, Website Build and E-commerce Build run independently today. Petra Core, the modules and every connection between them are built on request, and we are building them now."
    />
    )}

    <div class="glass relative hidden rounded-3xl p-5 lg:block" data-reveal>
      <svg viewBox={`0 0 ${W} 720`} class="h-auto w-full" role="img" aria-label="Diagram: five products (PetraPMS, PetraPOS, PetraDMS, Website Build, E-commerce Build) connect through Petra Core, which also connects to eight modules that PETRA builds on request. The core, the modules and all connections are built on request.">
        {/* core to modules */}
        {mods.map((m) => (
          <path d={`M${CORE.x + CORE.w / 2} ${CORE.y} V${BUS_UP} H${m.cx} V${MOD_Y + MOD_H}`} fill="none" stroke="#3fd0d3" stroke-width="1.2" stroke-dasharray="4 8" stroke-opacity="0.4" class="flow" />
        ))}
        {/* core to products */}
        {coreLinks.map((l) => {
          const n = nodeByKey[l.data.from];
          const w = labelW(l.data.label);
          return (
            <g>
              <path d={`M${CORE.x + CORE.w / 2} ${CORE.y + CORE.h} V${BUS_DOWN} H${n.x} V${NODE_Y}`} fill="none" stroke="#3fd0d3" stroke-width="1.6" stroke-dasharray="6 8" stroke-opacity="0.85" class="flow" />
              <g transform={`translate(${n.x - w / 2} ${NODE_Y - 46})`}>
                <rect width={w} height="24" rx="12" fill="#0c1d35" stroke="rgba(255,255,255,0.28)" />
                <text x={w / 2} y="16" text-anchor="middle" font-size="12.5" fill="#fff" font-weight="500">{l.data.label}</text>
              </g>
            </g>
          );
        })}
        {/* product to product */}
        {sideLinks.map((l) => {
          const a = nodeByKey[l.data.from];
          const b = nodeByKey[l.data.to];
          const x1 = a.x + (b.x > a.x ? 50 : -50);
          const x2 = b.x + (b.x > a.x ? -50 : 50);
          const y = NODE_Y + NODE_H;
          const w = labelW(l.data.label);
          return (
            <g>
              <path d={`M${x1} ${y} V${y + 44} H${x2} V${y}`} fill="none" stroke="#3fd0d3" stroke-width="1.6" stroke-dasharray="6 8" stroke-opacity="0.85" class="flow" />
              <g transform={`translate(${(x1 + x2) / 2 - w / 2} ${y + 32})`}>
                <rect width={w} height="24" rx="12" fill="#0c1d35" stroke="rgba(255,255,255,0.28)" />
                <text x={w / 2} y="16" text-anchor="middle" font-size="12.5" fill="#fff" font-weight="500">{l.data.label}</text>
              </g>
            </g>
          );
        })}

        {/* modules built on request */}
        <text x={modStart} y="17" font-size="10" fill="#3fd0d3" letter-spacing="2.4">MODULES · BUILT ON REQUEST</text>
        {mods.map((m) => (
          <g>
            <rect x={m.x} y={MOD_Y} width={modW} height={MOD_H} rx="14" fill="#14284a" stroke="#3fd0d3" stroke-opacity="0.75" />
            <text x={m.cx} y={MOD_Y + 26} text-anchor="middle" font-size="14" font-weight="600" fill="#fff">{m.name}</text>
            <text x={m.cx} y={MOD_Y + 46} text-anchor="middle" font-size="10" fill="#3fd0d3" letter-spacing="1.6">{m.group.toUpperCase()}</text>
          </g>
        ))}

        {/* core */}
        <g>
          <rect x={CORE.x} y={CORE.y} width={CORE.w} height={CORE.h} rx="18" fill="#14284a" stroke="#3fd0d3" />
          <text x={CORE.x + 28} y={CORE.y + 32} font-size="11" fill="#3fd0d3" letter-spacing="2.4">PETRA CORE · BUILT ON REQUEST</text>
          <text x={CORE.x + 28} y={CORE.y + 62} font-size="25" font-weight="600" fill="#fff">{core.name}</text>
          <text x={CORE.x + 28} y={CORE.y + 82} font-size="12.5" fill="rgba(255,255,255,0.72)">{core.sub}</text>
        </g>

        {/* products */}
        {nodes.map((n) => (
          <g>
            <rect x={n.x - nodeW / 2} y={NODE_Y} width={nodeW} height={NODE_H} rx="16" fill="#14284a" stroke="rgba(255,255,255,0.35)" />
            <text x={n.x - nodeW / 2 + 22} y={NODE_Y + 36} font-size="24" font-weight="700" fill="#fff" letter-spacing="2">{n.code}</text>
            <text x={n.x - nodeW / 2 + 22} y={NODE_Y + 59} font-size="13.5" font-weight="600" fill="#3fd0d3">{n.name}</text>
            <text x={n.x - nodeW / 2 + 22} y={NODE_Y + 79} font-size="12" fill="rgba(255,255,255,0.7)">{n.short}</text>
            <rect x={n.x + nodeW / 2 - 76} y={NODE_Y + 12} width="64" height="19" rx="9.5" fill="none" stroke="rgba(255,255,255,0.5)" />
            <text x={n.x + nodeW / 2 - 44} y={NODE_Y + 25} text-anchor="middle" font-size="9.5" fill="#fff">PREVIEW</text>
          </g>
        ))}

        {/* legend */}
        <g transform="translate(36 690)" font-size="12" fill="rgba(255,255,255,0.75)">
          <rect y="-10" width="22" height="13" rx="3" fill="#14284a" stroke="rgba(255,255,255,0.5)" />
          <text x="32">Product in preview</text>
          <rect x="190" y="-10" width="22" height="13" rx="3" fill="#14284a" stroke="#3fd0d3" />
          <text x="222">Built on request: module or core</text>
          <path d="M430 -3 H462" stroke="#3fd0d3" stroke-dasharray="6 5" stroke-width="1.6" />
          <text x="472">Dashed line: connection built on request</text>
        </g>
      </svg>
    </div>

    <div class="space-y-4 lg:hidden">
      <div class="glass rounded-2xl border-glow/40 p-4">
        <div class="flex items-center justify-between gap-3"><b class="text-[15px]">{core.name}</b><Chip status="onrequest" dark /></div>
        <p class="mt-1.5 text-[12.5px] leading-relaxed text-white/75">{core.role}</p>
      </div>
      <div>
        <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.18em] text-white/60">Products today</p>
        <div class="hs grid gap-3 sm:grid-cols-3">
          {nodes.map((n) => (
            <div class="glass rounded-2xl p-4">
              <p class="text-[11px] font-semibold tracking-[0.18em] text-glow">{n.code}</p>
              <p class="mt-1 text-[15px] font-medium">{n.name}</p>
              <p class="mt-0.5 text-[12px] text-white/70">{n.short}</p>
              <div class="mt-3"><Chip status="preview" dark /></div>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.18em] text-white/60">Modules built on request</p>
        <ul class="flex flex-wrap gap-2">
          {requestModules.map((m) => <li class="rounded-full border border-glow/50 bg-white/5 px-3 py-1.5 text-[12px] text-white/90">{m.name}</li>)}
        </ul>
      </div>
    </div>

    {
      detail && (
        <div class="mt-8 grid gap-8 sm:mt-14 sm:gap-10 lg:grid-cols-2">
          <div data-reveal>
            <h2 class="mb-4 text-[13px] font-medium uppercase tracking-[0.18em] text-white/70">Connections built on request</h2>
            <ul class="divide-y divide-white/10 border-y border-white/10">
              {links.map((l) => (
                <li class="flex items-center justify-between gap-4 py-2.5 sm:items-start sm:py-3.5">
                  <div><p class="text-[14px] font-medium">{l.data.label}</p><p class="mt-0.5 hidden text-[12.5px] text-white/65 sm:block">{l.data.detail}</p></div>
                  <Chip status={l.data.status} dark />
                </li>
              ))}
            </ul>
          </div>
          <div class="hidden sm:block" data-reveal style="--d:1">
            <h2 class="mb-4 text-[13px] font-medium uppercase tracking-[0.18em] text-white/70">Modules built on request</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {requestModules.map((m) => (
                <li class="glass spot spot-dark rounded-xl border-glow/40 px-4 py-3">
                  <p class="text-[13px] font-medium">{m.name}</p>
                  <p class="mt-0.5 text-[12px] text-white/65">{m.role}</p>
                  <p class="mt-2 text-[10.5px] uppercase tracking-[0.14em] text-glow">{m.group} · Built on request</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
    {!detail && <div class="mt-6 sm:mt-10" data-reveal><Button href="/ecosystem" variant="ghost-dark" class="w-full sm:w-auto">See the modules</Button></div>}
  </div>
</section>
