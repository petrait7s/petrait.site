---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Chip from "../ui/Chip.astro";
import SectionHead from "../ui/SectionHead.astro";
import { screenImage } from "../../lib/screens";

interface Props {
  withHead?: boolean;
}
const { withHead = true } = Astro.props;
const products = await getCollection("products");
const span = ["lg:col-span-2", "lg:col-span-2", "lg:col-span-2", "lg:col-span-3", "lg:col-span-3"];
---

<section id="products" class="px-6 py-24 sm:px-10 sm:py-32">
  <div class="mx-auto max-w-6xl">
    {
      !withHead && <h2 class="sr-only">All products</h2>
    }
    {
      withHead && (
        <SectionHead
          eyebrow="Products"
          title="Five products, built for the way work really happens."
          lede="Hotel, restaurant, distribution, website and online store: each built for the way the work really happens. All are in preview; screens are samples."
        />
      )
    }
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        products.map((p, i) => (
          <a
            href={`/products/${p.id}`}
            class:list={["spot group flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:shadow-[0_24px_50px_-24px_rgba(3,141,145,0.5)]", span[i]]}
            data-reveal
            style={`--d:${i % 3}`}
          >
            <div class="relative aspect-[16/9] overflow-hidden bg-stage">
              <Image
                src={screenImage(p.data.assetPrefix, p.data.screens[0].view, "desktop")}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 420px, 92vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]"
              />
              <span class="absolute left-3 top-3 rounded-md bg-stage/85 px-2 py-1 text-[10.5px] font-semibold tracking-[0.14em] text-glow">{p.data.code}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-[17px] font-medium tracking-tight">{p.data.name}</h3>
                <Chip status={p.data.status} />
              </div>
              <p class="mt-0.5 text-[12px] text-ink-3">{p.data.full}</p>
              <p class="mt-3 flex-1 text-[13px] leading-relaxed text-ink-2">{p.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[12.5px] font-medium text-accent-text">
                Explore {p.data.name}
                <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
