---
import Logo from "./Logo.astro";
import SocialLink from "../ui/SocialLink.astro";
import { footerLinks, site } from "../../content/site";

const col = "mb-3 text-[11.5px] font-medium text-ink-3";
const link = "inline-block py-1 text-[13px] text-ink-2 transition-colors hover:text-ink";
---

<footer class="bg-surface px-5 pb-8 pt-9 sm:px-12 sm:pb-10 sm:pt-16 md:px-20 lg:px-28">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-5 gap-y-7 sm:gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div class="col-span-2 md:col-span-1">
      <div class="flex items-center gap-2.5">
        <Logo size={36} />
        <span class="text-[14px] font-medium tracking-wide">{site.name}</span>
      </div>
      <p class="mt-3 max-w-[34ch] text-[12.5px] leading-relaxed text-ink-2 sm:mt-4">{site.legalName} builds software in {site.country}: products for hospitality and business, and custom software of any type on client demand.</p>
    </div>
    <nav aria-label="Products">
      <h2 class={col}>Products</h2>
      <ul class="space-y-0.5">
        {footerLinks.products.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2 class={col}>Company</h2>
      <ul class="space-y-0.5">
        {footerLinks.company.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="col-span-2 md:col-span-1">
      <h2 class={col}>Contact</h2>
      <ul class="space-y-0.5 break-words">
        <li><a href={`mailto:${site.email}`} class={link}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`} class={link}>{site.phone}</a></li>
        <li class="py-1 text-[13px] text-ink-2">{site.country}</li>
      </ul>
      <div class="mt-4 flex flex-wrap gap-2 sm:mt-5">
        <SocialLink network="facebook" href={site.facebook} />
        <SocialLink network="instagram" href={site.instagram} />
      </div>
    </div>
  </div>
  <div class="mx-auto mt-8 flex max-w-6xl flex-col items-center gap-3 border-t border-line pt-5 text-center text-[12px] text-ink-2 sm:mt-12 sm:flex-row sm:flex-wrap sm:justify-between sm:pt-6 sm:text-left">
    <span>© {new Date().getFullYear()} {site.legalName}. All rights reserved.</span>
    <ul class="flex gap-5">
      {footerLinks.legal.map((l) => <li><a href={l.href} class="inline-block py-1 hover:text-ink">{l.label}</a></li>)}
    </ul>
  </div>
</footer>
