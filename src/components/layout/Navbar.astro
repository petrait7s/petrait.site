---
import Logo from "./Logo.astro";
import { nav, site } from "../../content/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const link = "text-[14px] font-medium transition-colors duration-200 hover:text-ink";
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-8 sm:pt-6">
  <div class="relative mx-auto flex max-w-5xl items-center justify-center gap-2 sm:gap-3">
    <a
      href="/"
      aria-label={`${site.name} home`}
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl sm:h-11 sm:w-11"
    >
      <Logo size={44} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 rounded-xl bg-surface px-8 py-3 lg:flex">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={isActive(n.href) ? "page" : undefined}
            class:list={[link, isActive(n.href) ? "text-ink" : "text-ink-2"]}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/contact"
      class="hidden h-11 items-center rounded-xl bg-accent-text px-5 text-[13px] font-medium text-white shadow-lg shadow-black/20 transition-colors duration-200 hover:bg-accent sm:inline-flex"
    >
      Book a demo
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
      class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-ink-2 hover:text-ink sm:h-11 sm:w-11 lg:hidden"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path data-bar="top" d="M3 5h12" class="origin-center transition-transform duration-200"></path>
        <path data-bar="mid" d="M3 9h12" class="transition-opacity duration-200"></path>
        <path data-bar="bot" d="M3 13h12" class="origin-center transition-transform duration-200"></path>
      </svg>
    </button>

    <nav
      id="mobile-nav"
      aria-label="Mobile"
      hidden
      class="absolute inset-x-0 top-full mt-2 rounded-2xl bg-surface p-3 shadow-lg lg:hidden"
    >
      <ul class="flex flex-col">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={isActive(n.href) ? "page" : undefined}
                class:list={[
                  "flex min-h-11 items-center rounded-lg px-3 text-[14px] font-medium transition-colors hover:bg-page",
                  isActive(n.href) ? "text-ink" : "text-ink-2",
                ]}
              >
                {n.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-line pt-3">
          <a href="/contact" class="flex min-h-11 items-center justify-center rounded-xl bg-ink text-[13px] font-medium text-white">
            Book a demo
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const $ = (id: string) => document.getElementById(id);

  function setOpen(open: boolean, returnFocus = false) {
    const btn = $("menu-toggle");
    const panel = $("mobile-nav");
    if (!btn || !panel) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    panel.hidden = !open;
    const bar = (n: string) => btn.querySelector<SVGPathElement>(`[data-bar="${n}"]`);
    bar("top")?.setAttribute("style", open ? "transform: translateY(4px) rotate(45deg)" : "");
    bar("bot")?.setAttribute("style", open ? "transform: translateY(-4px) rotate(-45deg)" : "");
    bar("mid")?.setAttribute("style", open ? "opacity: 0" : "");
    if (!open && returnFocus) btn.focus();
  }

  const isOpen = () => $("menu-toggle")?.getAttribute("aria-expanded") === "true";

  // Document-level listeners are added once; page elements are re-bound on every page load.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false, true);
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });

  document.addEventListener("astro:page-load", () => {
    $("menu-toggle")?.addEventListener("click", () => setOpen(!isOpen()));
    $("mobile-nav")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
  });
</script>
