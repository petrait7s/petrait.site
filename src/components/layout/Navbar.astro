---
import Logo from "./Logo.astro";
import { nav, site } from "../../content/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const link = "text-[14px] font-medium transition-colors duration-200 hover:text-ink";

const ic = {
  home: '<path d="M3 11l9-8 9 8M5 10v10h14V10"/>',
  box: '<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  more: '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
};
const tabs = [
  { label: "Home", href: "/", icon: ic.home, on: path === "/" },
  { label: "Products", href: "/products", icon: ic.box, on: isActive("/products") },
  { label: "Ecosystem", href: "/ecosystem", icon: ic.layers, on: isActive("/ecosystem") },
  { label: "Contact", href: "/contact", icon: ic.mail, on: isActive("/contact") },
];
const moreOn = !tabs.some((t) => t.on);
const more = [
  { label: "Deployment", href: "/deployment" },
  { label: "Industries", href: "/industries" },
  { label: "Why Petra", href: "/why-petra" },
  { label: "Implementation", href: "/implementation" },
  { label: "Privacy", href: "/privacy" },
];
---

<!-- Desktop: floating pill navigation -->
<header id="site-header" class="fixed inset-x-0 top-0 z-50 hidden px-8 pt-6 lg:block">
  <div class="mx-auto flex max-w-5xl items-center justify-center gap-3">
    <a href="/" aria-label={`${site.name} home`} class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl">
      <Logo size={44} />
    </a>
    <nav aria-label="Primary" class="flex items-center gap-8 rounded-xl bg-surface px-8 py-3">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined} class:list={[link, isActive(n.href) ? "text-ink" : "text-ink-2"]}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <a href="/contact" class="inline-flex h-11 items-center rounded-xl bg-accent-text px-5 text-[13px] font-medium text-white shadow-lg shadow-black/20 transition-colors duration-200 hover:bg-accent">Book a demo</a>
  </div>
</header>

<!-- Phone and tablet: slim top bar plus an app-style bottom tab bar -->
<header class="fixed inset-x-0 top-0 z-50 flex h-[52px] items-center justify-between border-b border-white/10 bg-[rgba(12,29,53,0.88)] px-4 backdrop-blur-md lg:hidden">
  <a href="/" aria-label={`${site.name} home`} class="flex items-center gap-2.5 text-white">
    <Logo size={32} />
    <span class="text-[14px] font-semibold tracking-[0.18em]">{site.name}</span>
  </a>
  <a href="/contact" class="press inline-flex h-9 items-center rounded-full bg-accent-text px-4 text-[12.5px] font-medium text-white">Book a demo</a>
</header>

<nav aria-label="Main" class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-[rgba(12,29,53,0.96)] pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-12px_rgba(12,29,53,0.6)] backdrop-blur-md lg:hidden">
  <ul class="mx-auto flex max-w-xl items-stretch justify-around">
    {
      tabs.map((t) => (
        <li class="flex-1">
          <a href={t.href} aria-current={t.on ? "page" : undefined} class:list={["press flex h-[62px] flex-col items-center justify-center gap-1 text-[10.5px] font-medium", t.on ? "text-white" : "text-white/60"]}>
            <span class:list={["grid h-7 w-12 place-items-center rounded-full transition-colors", t.on && "bg-accent"]}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
            </span>
            {t.label}
          </a>
        </li>
      ))
    }
    <li class="flex-1">
      <button id="more-toggle" type="button" aria-expanded="false" aria-controls="more-sheet" class:list={["press flex h-[62px] w-full flex-col items-center justify-center gap-1 text-[10.5px] font-medium", moreOn ? "text-white" : "text-white/60"]}>
        <span class:list={["grid h-7 w-12 place-items-center rounded-full transition-colors", moreOn && "bg-accent"]}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="none" aria-hidden="true" set:html={ic.more} />
        </span>
        More
      </button>
    </li>
  </ul>
</nav>

<div id="more-backdrop" hidden class="fixed inset-0 z-40 bg-ink/50 lg:hidden"></div>
<div id="more-sheet" hidden role="dialog" aria-label="More pages" class="fixed inset-x-0 bottom-[calc(66px+env(safe-area-inset-bottom))] z-40 mx-3 rounded-2xl border border-white/10 bg-stage p-2 shadow-2xl lg:hidden">
  <ul>
    {
      more.map((m) => (
        <li>
          <a href={m.href} aria-current={isActive(m.href) ? "page" : undefined} class="press flex min-h-12 items-center justify-between rounded-xl px-4 text-[14px] font-medium text-white hover:bg-white/10">
            {m.label}
            <span class="text-white/50" aria-hidden="true">›</span>
          </a>
        </li>
      ))
    }
    {
      [["Facebook page", site.facebook], ["Instagram", site.instagram]].map(([label, href]) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="press flex min-h-12 items-center justify-between rounded-xl px-4 text-[14px] font-medium text-white hover:bg-white/10">
            {label} <span class="sr-only">(opens in a new tab)</span><span class="text-white/50" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const $ = (id: string) => document.getElementById(id);

  function setOpen(open: boolean, returnFocus = false) {
    const btn = $("more-toggle");
    const sheet = $("more-sheet");
    const back = $("more-backdrop");
    if (!btn || !sheet || !back) return;
    btn.setAttribute("aria-expanded", String(open));
    sheet.hidden = !open;
    back.hidden = !open;
    if (!open && returnFocus) btn.focus();
  }
  const isOpen = () => $("more-toggle")?.getAttribute("aria-expanded") === "true";

  // Document-level listeners are added once; the elements are re-bound on every page load.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false, true);
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });

  document.addEventListener("astro:page-load", () => {
    $("more-toggle")?.addEventListener("click", () => setOpen(!isOpen()));
    $("more-backdrop")?.addEventListener("click", () => setOpen(false));
    $("more-sheet")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
  });
</script>
